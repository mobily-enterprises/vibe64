{
  "name": "vibe64",
  "version": "0.1.25",
  "private": false,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "description": "Run Vibe64 against the current project.",
  "bin": {
    "vibe64": "bin/run.js"
  },
  "files": [
    "app.json",
    "bin/",
    "config/",
    "dist/",
    "packages/",
    "server.js",
    "server/",
    "tooling/"
  ],
  "bundleDependencies": [
    "@local/vibe64-accounts",
    "@local/vibe64-core",
    "@local/vibe64-database-tools",
    "@local/vibe64-execution",
    "@local/vibe64-genesis",
    "@local/vibe64-project",
    "@local/vibe64-runtime",
    "@local/vibe64-sessions",
    "@local/vibe64-source-editor",
    "@local/vibe64-system-graph",
    "@local/vibe64-terminals",
    "@local/current-app",
    "@local/main",
    "@local/studio-health",
    "@local/studio-terminal-core",
    "genesis-compiler",
    "genesis-stack"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "26.x"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "node-pty@1.1.0": true,
    "vue-demi@0.14.10": true
  },
  "scripts": {
    "prepack": "npm run verify:packages && npm run build && npm run prune:packaged-deps",
    "server": "node ./bin/server.js --no-open",
    "server:all": "node ./bin/server.js --no-open",
    "server:app": "SERVER_SURFACE=app node ./bin/server.js --no-open",
    "start": "node ./bin/server.js --no-open",
    "dev": "node ./bin/dev.js",
    "dev:all": "vite",
    "dev:app": "VITE_SURFACE=app node ./bin/dev.js",
    "build": "vite build",
    "build:all": "vite build",
    "build:app": "VITE_SURFACE=app vite build",
    "preview": "vite preview",
    "docs:dev": "vitepress dev docs/site",
    "docs:build": "vitepress build docs/site",
    "docs:preview": "vitepress preview docs/site",
    "lint": "eslint .",
    "test": "node tooling/run-targeted-tests.mjs",
    "test:full": "node --test --test-concurrency=1 tests/server/*.test.js",
    "test:client": "vitest run tests/client",
    "test:e2e": "playwright test --config playwright.config.mjs tests/e2e/self-contained-smoke.spec.ts tests/e2e/direct-chat.spec.ts tests/e2e/session-renewal.spec.ts && npm run test:e2e:preview",
    "test:e2e:preview": "playwright test --config playwright.config.mjs tests/e2e/launch-preview-terminal.spec.ts --grep @preview-lifecycle",
    "test:e2e:shell": "playwright test --config playwright.config.mjs tests/e2e/base-shell.spec.ts",
    "cloc": "npm run cloc:src && npm run cloc:other",
    "cloc:src": "git ls-files | rg '^(src/|packages/[^/]+/src/client/)' | rg -v '(^|/)(test|tests)/|(^|/)package-lock\\.json$' | cloc --by-file --timeout 60 --exclude-ext=md,txt,text --list-file=-",
    "cloc:other": "git ls-files | rg -v '^(src/|packages/[^/]+/src/client/)' | rg -v '(^|/)(test|tests)/|(^|/)package-lock\\.json$' | cloc --by-file --timeout 60 --exclude-ext=md,txt,text --list-file=-",
    "verify": "npm run lint && npm run test:full && npm run test:client && npm run build && npm run verify:packages",
    "verify:packages": "node ./tooling/verify-package-boundaries.mjs",
    "prune:packaged-deps": "node ./tooling/prune-packaged-deps.mjs",
    "smoke:package": "node ./tooling/package-install-smoke.mjs",
    "smoke:new-project": "node ./tooling/verify-new-project-foundation.mjs",
    "release": "node ./scripts/npm-release.js",
    "dev:home": "VITE_SURFACE=home vite",
    "jskit:update": "npx --yes @jskit-ai/jskit-catalog@latest update",
    "jskit:check": "jskit check"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.4",
    "@fastify/static": "^9.1.1",
    "@fastify/websocket": "^11.2.0",
    "@jskit-ai/http-runtime": "0.1.179",
    "@jskit-ai/http-web": "0.1.26",
    "@jskit-ai/kernel": "0.1.181",
    "@jskit-ai/realtime": "0.1.178",
    "@jskit-ai/shell-web": "0.1.185",
    "@jskit-ai/uploads-runtime": "0.1.156",
    "@local/current-app": "0.1.0",
    "@local/main": "0.1.0",
    "@local/studio-health": "0.1.0",
    "@local/studio-terminal-core": "0.1.0",
    "@local/vibe64-accounts": "0.1.0",
    "@local/vibe64-core": "0.1.0",
    "@local/vibe64-database-tools": "0.1.0",
    "@local/vibe64-execution": "0.1.0",
    "@local/vibe64-genesis": "0.1.0",
    "@local/vibe64-project": "0.1.0",
    "@local/vibe64-runtime": "0.1.0",
    "@local/vibe64-sessions": "0.1.0",
    "@local/vibe64-source-editor": "0.1.0",
    "@local/vibe64-system-graph": "0.1.0",
    "@local/vibe64-terminals": "0.1.0",
    "@mdi/js": "^7.4.47",
    "@socket.io/redis-adapter": "^8.3.0",
    "@tanstack/vue-query": "^5.90.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "diff": "^8.0.4",
    "diff2html": "^3.4.56",
    "execa": "^9.6.1",
    "fastify": "^5.7.4",
    "genesis-compiler": "1.5.0",
    "genesis-stack": "1.1.0",
    "get-port": "^7.2.0",
    "json-rest-schema": "^1.0.16",
    "node-pty": "^1.1.0",
    "open": "^11.0.0",
    "pinia": "^3.0.4",
    "redis": "^5.8.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "strip-ansi": "^7.2.0",
    "vue": "^3.5.13",
    "vue-router": "5.0.7",
    "vuetify": "^4.0.0",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@jskit-ai/agent-docs": "0.1.153",
    "@jskit-ai/config-eslint": "0.1.178",
    "@jskit-ai/jskit-catalog": "0.1.206",
    "@playwright/test": "1.61.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^10.8.0",
    "vite": "^6.1.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "vitepress": {
      "vite": "6.4.3"
    }
  }
}
