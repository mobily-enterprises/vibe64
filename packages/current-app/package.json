{
  "name": "@local/current-app",
  "version": "0.1.0",
  "description": "Inspect the current project's explicit Vibe64 output targets.",
  "private": true,
  "type": "module",
  "exports": {
    "./server/actions": "./src/server/actions.js"
  },
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [
        "vibe64.current-app"
      ],
      "requires": [
        "runtime.actions",
        "runtime.env",
        "runtime.http",
        "vibe64.project"
      ]
    },
    "runtime": {
      "server": {
        "providers": [
          {
            "entrypoint": "src/server/CurrentAppProvider.js",
            "export": "CurrentAppProvider"
          }
        ],
        "capabilities": [
          "vibe64.current-app"
        ]
      },
      "client": {
        "providers": []
      }
    },
    "metadata": {
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./server/actions",
            "summary": "Exports the Vibe64 Outputs inspection action."
          }
        ]
      }
    }
  },
  "dependencies": {
    "@jskit-ai/kernel": "0.1.183",
    "@local/vibe64-core": "0.1.0",
    "@local/vibe64-genesis": "0.1.0",
    "@local/vibe64-project": "0.1.0",
    "json-rest-schema": "^1.0.16"
  }
}
