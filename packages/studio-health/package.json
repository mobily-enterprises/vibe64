{
  "name": "@local/studio-health",
  "version": "0.1.0",
  "description": "Read-only health checks for the Vibe64 host platform.",
  "private": true,
  "type": "module",
  "exports": {
    "./server/actions": "./src/server/actions.js",
    "./server/service": "./src/server/service.js"
  },
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [
        "vibe64.studio-health"
      ],
      "requires": [
        "runtime.actions",
        "runtime.http",
        "vibe64.connections",
        "vibe64.project"
      ]
    },
    "runtime": {
      "server": {
        "providers": [
          {
            "entrypoint": "src/server/StudioHealthProvider.js",
            "export": "StudioHealthProvider"
          }
        ],
        "capabilities": [
          "vibe64.studio-health"
        ]
      },
      "client": {
        "providers": []
      }
    },
    "metadata": {
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./server/service",
            "summary": "Inspects Vibe64 platform commands, credentials, Genesis, browser runtime, and workspace services."
          }
        ]
      }
    }
  },
  "dependencies": {
    "@jskit-ai/kernel": "0.1.183",
    "@local/vibe64-accounts": "0.1.0",
    "@local/vibe64-core": "0.1.0",
    "@local/vibe64-execution": "0.1.0",
    "@local/vibe64-genesis": "0.1.0",
    "@local/vibe64-project": "0.1.0",
    "json-rest-schema": "^1.0.16"
  }
}
