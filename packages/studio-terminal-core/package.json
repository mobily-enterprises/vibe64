{
  "name": "@local/studio-terminal-core",
  "version": "0.1.0",
  "description": "Shared Studio terminal access, credential-home, and managed runtime primitives.",
  "private": true,
  "type": "module",
  "exports": {
    "./server": "./src/server/index.js",
    "./server/*": "./src/server/*.js",
    "./shared": "./src/shared/index.js"
  },
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [],
      "requires": []
    },
    "runtime": {
      "server": {
        "providers": []
      },
      "client": {
        "providers": []
      }
    },
    "metadata": {
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./server",
            "summary": "Exports terminal access controls, Studio runtime identity, credential-home helpers, and managed services."
          }
        ]
      }
    }
  },
  "dependencies": {
    "@jskit-ai/assistant-core": "0.1.208",
    "@local/vibe64-core": "0.1.0",
    "@local/vibe64-execution": "0.1.0",
    "node-pty": "^1.1.0"
  }
}
