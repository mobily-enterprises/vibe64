{
  "name": "@local/vibe64-accounts",
  "version": "0.1.0",
  "description": "Owns Vibe64 account readiness and login orchestration.",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/client/index.js",
    "./server/actions": "./src/server/actions.js",
    "./server/accountRealtimeEvents": "./src/server/accountRealtimeEvents.js",
    "./server/githubCliAuth": "./src/server/githubCliAuth.js",
    "./server/registerRoutes": "./src/server/registerRoutes.js",
    "./server/service": "./src/server/service.js"
  },
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [
        "vibe64.accounts",
        "vibe64.connections"
      ],
      "requires": [
        "runtime.actions",
        "runtime.env",
        "runtime.events",
        "runtime.fastify",
        "runtime.http",
        "vibe64.project"
      ]
    },
    "runtime": {
      "server": {
        "providers": [
          {
            "entrypoint": "src/server/Vibe64AccountsFeature.js",
            "export": "Vibe64AccountsFeature"
          }
        ]
      },
      "client": {
        "providers": []
      }
    },
    "metadata": {
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./server/registerRoutes",
            "summary": "Registers Vibe64 account status and login orchestration routes."
          },
          {
            "subpath": "./server/service",
            "summary": "Owns GitHub and Codex auth status checks plus hidden CLI login sessions."
          },
          {
            "subpath": "./server/githubCliAuth",
            "summary": "Classifies and redacts GitHub CLI authentication failures for hosted GitHub operations."
          }
        ]
      }
    }
  },
  "dependencies": {
    "@jskit-ai/http-web": "0.1.28",
    "@jskit-ai/kernel": "0.1.183",
    "@jskit-ai/realtime": "0.1.180",
    "@mdi/js": "^7.4.47",
    "@local/studio-terminal-core": "0.1.0",
    "@local/vibe64-core": "0.1.0",
    "@local/vibe64-execution": "0.1.0",
    "@local/vibe64-project": "0.1.0",
    "@tanstack/vue-query": "^5.90.5",
    "json-rest-schema": "^1.0.16",
    "strip-ansi": "^7.2.0",
    "vue": "^3.5.13"
  }
}
