{
  "name": "@local/vibe64-accounts",
  "version": "0.1.0",
  "description": "Owns Vibe64 account readiness and login orchestration.",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/client/index.js",
    "./server/actions": "./src/server/accountsActions.js",
    "./server/accountRealtimeEvents": "./src/server/accountRealtimeEvents.js",
    "./server/accountsRuntime": "./src/server/accountsRuntime.js",
    "./server/githubCliAuth": "./src/server/githubCliAuth.js",
    "./server/registerRoutes": "./src/server/registerRoutes.js",
    "./server/service": "./src/server/service.js",
    "./bin/claude-auth-browser": "./bin/claude-auth-browser",
    "./server/aiConnectionService": "./src/server/aiConnectionService.js",
    "./server/aiConnectionRuntime": "./src/server/aiConnectionRuntime.js",
    "./server/assistantRoutingUpgrade": "./src/server/assistantRoutingUpgrade.js",
    "./server/assistantRoleUpgrade": "./src/server/assistantRoleUpgrade.js",
    "./server/assistantHelperUpgrade": "./src/server/assistantHelperUpgrade.js",
    "./server/providerCredentialsUpgrade": "./src/server/providerCredentialsUpgrade.js",
    "./server/freeModelRetirementUpgrade": "./src/server/freeModelRetirementUpgrade.js",
    "./server/teamSetupRoutingUpgrade": "./src/server/teamSetupRoutingUpgrade.js",
    "./server/types": "./src/server/types.js"
  },
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [
        "vibe64.accounts",
        "vibe64.connections"
      ],
      "requires": [
        "runtime.actions",
        "runtime.env",
        "runtime.events",
        "runtime.fastify",
        "runtime.http",
        "runtime.logger",
        "vibe64.project",
        "vibe64.terminals"
      ]
    },
    "runtime": {
      "server": {
        "providers": [
          {
            "entrypoint": "src/server/Vibe64AccountsFeature.js",
            "export": "Vibe64AccountsFeature"
          }
        ]
      },
      "client": {
        "providers": []
      }
    },
    "metadata": {
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./server/registerRoutes",
            "summary": "Registers Vibe64 account status and login orchestration routes."
          },
          {
            "subpath": "./server/service",
            "summary": "Owns native GitHub, Codex and Claude authentication plus hidden CLI login sessions."
          },
          {
            "subpath": "./server/githubCliAuth",
            "summary": "Classifies and redacts GitHub CLI authentication failures for the GitHub operations Vibe64 runs."
          }
        ]
      }
    }
  },
  "dependencies": {
    "@jskit-ai/http-web": "0.2.39",
    "@jskit-ai/kernel": "0.2.23",
    "@jskit-ai/realtime": "0.2.35",
    "@local/studio-terminal-core": "0.1.0",
    "@local/vibe64-core": "0.1.0",
    "@local/vibe64-execution": "0.1.0",
    "@local/vibe64-project": "0.1.0",
    "@local/vibe64-runtime": "0.1.0",
    "@tanstack/vue-query": "^5.90.5",
    "json-rest-schema": "^1.0.16",
    "strip-ansi": "^7.2.0",
    "vue": "^3.5.13",
    "vue-router": "^5.3.1",
    "vuetify": "^4.0.0"
  }
}
