{
  "name": "@local/vibe64-ai-tasks",
  "version": "0.1.0",
  "description": "Runs a specific job for an agent as one AI task: the problem, the conversation, the proof and the outcome, in one window that survives reloads and restarts.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client/index.js",
    "./client/types": "./src/client/types.js",
    "./server/types": "./src/server/types.js",
    "./shared": "./src/shared/index.js",
    "./server/actions": "./src/server/aiTaskActions.js"
  },
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [
        "vibe64.ai-tasks"
      ],
      "requires": [
        "runtime.env",
        "runtime.events",
        "runtime.http",
        "runtime.logger",
        "vibe64.database-tools",
        "vibe64.project",
        "vibe64.sessions",
        "vibe64.terminals"
      ]
    },
    "runtime": {
      "server": {
        "providers": [
          {
            "entrypoint": "src/server/Vibe64AiTasksFeature.js",
            "export": "Vibe64AiTasksFeature"
          }
        ],
        "capabilities": [
          "vibe64.ai-tasks"
        ]
      },
      "client": {
        "providers": []
      }
    },
    "metadata": {
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./server/actions",
            "summary": "Defines the actions that start, read, cancel, check, continue, finish and close a session's AI tasks."
          }
        ],
        "capabilities": [
          "vibe64.ai-tasks"
        ]
      }
    }
  },
  "dependencies": {
    "@jskit-ai/kernel": "0.2.7",
    "@jskit-ai/realtime": "0.2.11",
    "@local/vibe64-core": "0.1.0",
    "@local/vibe64-database-tools": "0.1.0",
    "@local/vibe64-project": "0.1.0",
    "@local/vibe64-runtime": "0.1.0",
    "@local/vibe64-sessions": "0.1.0",
    "@local/vibe64-terminals": "0.1.0",
    "@mdi/js": "^7.4.47",
    "json-rest-schema": "^1.0.16",
    "vue": "^3.5.44",
    "vue-router": "^5.3.1",
    "vuetify": "^4.0.0"
  }
}
