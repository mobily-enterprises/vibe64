{
  "name": "@local/vibe64-colleague",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The user's independent conversation for operating Vibe64.",
  "exports": {
    "./client": "./src/client/index.js",
    "./server": "./src/server/Vibe64ColleagueFeature.js",
    "./server/service": "./src/server/service.js",
    "./server/colleagueName": "./src/server/colleagueName.js",
    "./server/conversationUpgrade": "./src/server/conversationUpgrade.js",
    "./server/types": "./src/server/types.js",
    "./shared/learning-focus": "./src/shared/learningFocus.js",
    "./shared/navigation-panes": "./src/shared/navigationPanes.js"
  },
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [
        "vibe64.colleague",
        "vibe64.colleague.browser-focus"
      ],
      "requires": [
        "runtime.actions",
        "runtime.env",
        "runtime.events",
        "runtime.http",
        "runtime.logger",
        "runtime.realtime",
        "vibe64.accounts",
        "vibe64.terminals"
      ]
    },
    "runtime": {
      "server": {
        "providers": [
          {
            "entrypoint": "src/server/Vibe64ColleagueFeature.js",
            "export": "Vibe64ColleagueFeature"
          },
          {
            "entrypoint": "src/server/Vibe64ColleagueFeature.js",
            "export": "Vibe64ColleagueFocusFeature"
          }
        ],
        "capabilities": [
          "vibe64.colleague",
          "vibe64.colleague.browser-focus"
        ]
      },
      "client": {
        "providers": []
      }
    }
  },
  "dependencies": {
    "@jskit-ai/assistant-core": "0.2.17",
    "@jskit-ai/assistant-runtime": "0.2.19",
    "@jskit-ai/assistant-voice": "0.2.19",
    "@jskit-ai/kernel": "0.2.7",
    "@jskit-ai/realtime": "0.2.11",
    "@jskit-ai/shell-web": "0.2.8",
    "@local/studio-terminal-core": "0.1.0",
    "@local/vibe64-accounts": "0.1.0",
    "@local/vibe64-core": "0.1.0",
    "@local/vibe64-runtime": "0.1.0",
    "@local/vibe64-terminals": "0.1.0",
    "@local/vibe64-training": "0.1.0",
    "@local/vibe64-voice": "0.1.0",
    "@mdi/js": "^7.4.47",
    "vue": "^3.5.13",
    "vuetify": "^4.0.0"
  }
}
