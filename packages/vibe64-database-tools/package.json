{
  "name": "@local/vibe64-database-tools",
  "version": "0.1.0",
  "description": "Provides the active-session SQL workspace, schema browser, editable query results, ERD, and focused database copilot.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client/index.js",
    "./server/actions": "./src/server/actions.js",
    "./server/connection": "./src/server/connection.js",
    "./server/service": "./src/server/service.js"
  },
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [
        "vibe64.database-tools"
      ],
      "requires": [
        "runtime.actions",
        "runtime.events",
        "runtime.http",
        "runtime.logger",
        "vibe64.project",
        "vibe64.source-editor",
        "vibe64.terminals"
      ]
    },
    "runtime": {
      "server": {
        "providers": [
          {
            "entrypoint": "src/server/Vibe64DatabaseToolsProvider.js",
            "export": "Vibe64DatabaseToolsProvider"
          }
        ],
        "capabilities": [
          "vibe64.database-tools"
        ]
      },
      "client": {
        "providers": []
      }
    },
    "metadata": {
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./server/actions",
            "summary": "Defines the named active-session database actions used by the UI and automation."
          },
          {
            "subpath": "./server/service",
            "summary": "Coordinates authorized session database resolution, schema refresh, queries, edits, ERD state, and the focused copilot."
          }
        ],
        "capabilities": [
          "vibe64.database-tools"
        ]
      }
    }
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.4",
    "@jskit-ai/http-web": "0.1.28",
    "@jskit-ai/kernel": "0.1.183",
    "@jskit-ai/shell-web": "0.1.187",
    "@local/vibe64-core": "0.1.0",
    "@local/vibe64-execution": "0.1.0",
    "@local/vibe64-project": "0.1.0",
    "@local/vibe64-runtime": "0.1.0",
    "@local/vibe64-source-editor": "0.1.0",
    "@local/vibe64-terminals": "0.1.0",
    "@mdi/js": "^7.4.47",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "elkjs": "^0.12.0",
    "json-rest-schema": "^1.0.16",
    "knex": "^3.3.0",
    "mysql2": "^3.24.2",
    "pg": "^8.23.0",
    "vue": "^3.5.13"
  }
}
