{
  "name": "@local/vibe64-execution",
  "version": "0.1.0",
  "description": "Single Vibe64 command execution policy gateway.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/server/index.js",
    "./server": "./src/server/index.js",
    "./server/terminalSessions": "./src/server/engines/terminalSessions.js"
  },
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [],
      "requires": []
    },
    "runtime": {
      "server": {
        "providers": []
      },
      "client": {
        "providers": []
      }
    },
    "metadata": {
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./server",
            "summary": "Runs Vibe64 commands through one actor, environment, runtime path, policy, and execution gateway."
          },
          {
            "subpath": "./server/terminalSessions",
            "summary": "Low-level PTY terminal session lifecycle owned by the execution gateway."
          }
        ]
      }
    }
  },
  "dependencies": {
    "@jskit-ai/kernel": "0.1.224",
    "execa": "^9.6.1",
    "node-pty": "^1.1.0"
  }
}
