#!/usr/bin/env node

import { readFile, realpath } from "node:fs/promises";

// A host-disabled turn lane needs no compiler or Git setup.
if (process.argv[2] === "hook" && process.argv[3] === "turn" &&
    process.env.GENESIS_TURN_CONTEXT_ENABLED === "0") {
  process.exit(0);
}

const { withTrustedGitRepository } = await import("genesis-compiler");
const { runCli } = await import("genesis-compiler/cli");

const VIBE64_STACK_PACKAGES = Object.freeze(["genesis-stack"]);

function withVibe64StackPackages(argv = []) {
  if (!argv.length || argv.includes("--help") || argv.includes("-h") || argv[0] === "help") {
    return argv;
  }
  const [command, ...args] = argv;
  const supplied = new Set(args.flatMap((value, index) => (
    value === "--stack-package" && args[index + 1] ? [args[index + 1]] : []
  )));
  const packages = VIBE64_STACK_PACKAGES
    .filter((name) => !supplied.has(name))
    .flatMap((name) => ["--stack-package", name]);
  return [command, ...packages, ...args];
}

const argv = withVibe64StackPackages(process.argv.slice(2));
const registryPath = process.env.GENESIS_HOST_CONTEXT_RESOLVER_DATA
  ? JSON.parse(process.env.GENESIS_HOST_CONTEXT_RESOLVER_DATA).registryPath
  : "";
let trustedWorktree = "";
if (argv[0] === "hook" && registryPath) {
  // Native Codex and Claude hooks supply stdin; OpenCode supplies the same
  // input through the environment. Preserve it for Genesis after checking the
  // exact managed worktree, without changing the user message.
  if (process.env.GENESIS_HOST_CONTEXT_INPUT === undefined && !process.stdin.isTTY) {
    let input = "";
    for await (const chunk of process.stdin) {
      input += chunk;
      if (Buffer.byteLength(input) > 16 * 1024) throw new Error("The Genesis host hook input exceeds 16 KiB.");
    }
    process.env.GENESIS_HOST_CONTEXT_INPUT = input;
  }
  const input = JSON.parse(process.env.GENESIS_HOST_CONTEXT_INPUT || "{}");
  const registry = JSON.parse(await readFile(registryPath, "utf8"));
  const nativeSessionIds = [input.sessionId || input.session_id, ...(Array.isArray(input.parentSessionIds) ? input.parentSessionIds : [])];
  const session = registry.sessions?.find((entry) => (
    entry.upstreamSessionId && nativeSessionIds.includes(entry.upstreamSessionId)
  ));
  if (session?.workdir) {
    const worktree = await realpath(session.workdir);
    if (worktree === await realpath(process.cwd())) {
      trustedWorktree = worktree;
    }
  }
}
process.exitCode = trustedWorktree
  ? await withTrustedGitRepository(trustedWorktree, () => runCli(argv))
  : await runCli(argv);
