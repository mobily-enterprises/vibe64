{
  "name": "@local/vibe64-packaging",
  "version": "0.1.0",
  "description": "Host-neutral application distribution building blocks: packers, plan hashing, credential-free builds, sign/upload and read-back primitives.",
  "private": true,
  "type": "module",
  "bin": {
    "vibe64-publish": "./bin/vibe64-publish.js"
  },
  "exports": {
    "./server": "./src/server/index.js",
    "./server/plan": "./src/server/plan.js",
    "./server/stages": "./src/server/stages.js",
    "./server/confirmationToken": "./src/server/confirmationToken.js",
    "./server/tagSavedCommit": "./src/server/tagSavedCommit.js",
    "./server/packers": "./src/server/packers/index.js",
    "./server/destinations": "./src/server/destinations/index.js",
    "./server/preflight": "./src/server/preflight/index.js",
    "./server/preflight/registries": "./src/server/preflight/registries.js",
    "./server/release": "./src/server/release/index.js"
  },
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [],
      "requires": []
    },
    "runtime": {
      "server": {
        "providers": []
      },
      "client": {
        "providers": []
      }
    },
    "metadata": {
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./server",
            "summary": "Builds deterministic publish plans, runs credential-free builds into an immutable result store, and signs, uploads and reads back with credentials its caller supplies. Holds no state, history, custody policy or UI."
          }
        ]
      }
    }
  },
  "dependencies": {
    "@local/vibe64-execution": "0.1.0",
    "@local/vibe64-genesis": "0.1.0",
    "@local/vibe64-project": "0.1.0"
  }
}
