{
  "name": "@local/vibe64-project",
  "version": "0.1.0",
  "description": "Owns project selection, initial JSKIT project materialization, Env values, and session runtime creation.",
  "private": true,
  "type": "module",
  "exports": {
    "./server/actions": "./src/server/actions.js",
    "./server/managedProject": "./src/server/managedProject.js",
    "./server/resourceEnvironment": "./src/server/resourceEnvironment.js"
  },
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [
        "vibe64.project"
      ],
      "requires": [
        "runtime.actions",
        "runtime.env",
        "runtime.http"
      ]
    },
    "runtime": {
      "server": {
        "providers": [
          {
            "entrypoint": "src/server/Vibe64ProjectProvider.js",
            "export": "Vibe64ProjectProvider"
          }
        ]
      },
      "client": {
        "providers": []
      }
    },
    "metadata": {
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./server/actions",
            "summary": "Exports project actions, identifiers, and the shared project-change publisher."
          },
          {
            "subpath": "./server/managedProject",
            "summary": "Builds one Vibe64-owned JSKIT foundation commit and publishes it through an explicit repository authority."
          },
          {
            "subpath": "./server/resourceEnvironment",
            "summary": "Validates semantic host resource values and maps them through exact application-declared environment bindings."
          }
        ],
        "capabilities": [
          "vibe64.project"
        ]
      }
    }
  },
  "dependencies": {
    "@jskit-ai/kernel": "0.1.183",
    "@local/vibe64-core": "0.1.0",
    "@local/vibe64-execution": "0.1.0",
    "@local/vibe64-genesis": "0.1.0",
    "@local/vibe64-runtime": "0.1.0",
    "json-rest-schema": "^1.0.17"
  }
}
