{
  "name": "@local/vibe64-publishing",
  "version": "0.1.0",
  "description": "The local publishing experience: release orchestration, local targets and history, and the Publish page.",
  "private": true,
  "type": "module",
  "exports": {
    "./client/publish-page": "./src/client/PublishPage.vue",
    "./server/actions": "./src/server/actions.js",
    "./server/service": "./src/server/service.js",
    "./shared/destinationCatalog": "./src/shared/destinationCatalog.js"
  },
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [
        "vibe64.publishing"
      ],
      "requires": [
        "runtime.actions",
        "runtime.http",
        "vibe64.colleague",
        "vibe64.project",
        "vibe64.source-editor"
      ]
    },
    "runtime": {
      "server": {
        "providers": [
          {
            "entrypoint": "src/server/Vibe64PublishingProvider.js",
            "export": "Vibe64PublishingProvider"
          }
        ],
        "capabilities": [
          "vibe64.publishing"
        ]
      },
      "client": {
        "providers": []
      }
    },
    "metadata": {
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./client/publish-page",
            "summary": "Renders the project's Publish page: targets, release, confirmation, history, publishing keys and phone installs."
          },
          {
            "subpath": "./server/actions",
            "summary": "Defines the named publishing actions; irreversible and secret-handling ones accept only the person's own page requests."
          },
          {
            "subpath": "./server/service",
            "summary": "Orchestrates local releases (prepare, Save, plan, preflight, dry run, confirm, tag, build once, fan out, read back) with keys in the person's own age-encrypted store."
          },
          {
            "subpath": "./shared/destinationCatalog",
            "summary": "Describes each destination's needs, time and cost for the Add target dialog."
          }
        ],
        "capabilities": [
          "vibe64.publishing"
        ]
      }
    }
  },
  "dependencies": {
    "@jskit-ai/http-web": "0.2.1",
    "@jskit-ai/kernel": "0.2.0",
    "@jskit-ai/shell-web": "0.2.0",
    "@local/vibe64-core": "0.1.0",
    "@local/vibe64-execution": "0.1.0",
    "@local/vibe64-genesis": "0.1.0",
    "@local/vibe64-packaging": "0.1.0",
    "@local/vibe64-project": "0.1.0",
    "@local/vibe64-source-editor": "0.1.0",
    "@mdi/js": "^7.4.47",
    "json-rest-schema": "^1.0.16",
    "vue": "^3.5.44",
    "vuetify": "^4.0.0"
  }
}
