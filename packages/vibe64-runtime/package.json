{
  "name": "@local/vibe64-runtime",
  "version": "0.1.0",
  "description": "Vibe64 plain AI-session runtime, durable session store, and Codex bridge.",
  "private": true,
  "type": "module",
  "exports": {
    "./server": "./src/server/index.js",
    "./server/*": "./src/server/*.js",
    "./shared": "./src/shared/index.js"
  },
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [],
      "requires": []
    },
    "runtime": {
      "server": {
        "providers": []
      },
      "client": {
        "providers": []
      }
    },
    "metadata": {
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./server",
            "summary": "Exports the plain session runtime, durable session store, workspace preparation state, Codex bridge, source inspection, and session debug helpers."
          }
        ]
      }
    }
  },
  "dependencies": {
    "@local/vibe64-core": "0.1.0",
    "@local/vibe64-execution": "0.1.0",
    "@local/vibe64-genesis": "0.1.0",
    "@local/studio-terminal-core": "0.1.0",
    "strip-ansi": "^7.2.0",
    "ws": "^8.20.1",
    "@jskit-ai/assistant-core": "0.1.169"
  }
}
