{
  "name": "@local/vibe64-sessions",
  "version": "0.1.0",
  "description": "Owns plain Genesis-backed Vibe64 chat sessions.",
  "private": true,
  "type": "module",
  "exports": {
    "./server/actions": "./src/server/actions.js"
  },
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [
        "vibe64.sessions"
      ],
      "requires": [
        "runtime.actions",
        "runtime.events",
        "runtime.http",
        "vibe64.project",
        "vibe64.terminals"
      ]
    },
    "runtime": {
      "server": {
        "providers": [
          {
            "entrypoint": "src/server/Vibe64SessionsProvider.js",
            "export": "Vibe64SessionsProvider"
          }
        ]
      },
      "client": {
        "providers": []
      }
    },
    "metadata": {
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./server/actions",
            "summary": "Exports direct chat, workspace preparation, conversation, diff, interrupt, and close action identifiers."
          }
        ],
        "capabilities": [
          "vibe64.sessions"
        ]
      }
    }
  },
  "dependencies": {
    "@jskit-ai/kernel": "0.1.183",
    "@local/vibe64-core": "0.1.0",
    "@local/vibe64-execution": "0.1.0",
    "@local/vibe64-project": "0.1.0",
    "@local/vibe64-runtime": "0.1.0",
    "@local/vibe64-terminals": "0.1.0",
    "json-rest-schema": "^1.0.17"
  }
}
