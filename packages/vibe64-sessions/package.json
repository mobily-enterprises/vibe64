{
  "name": "@local/vibe64-sessions",
  "version": "0.1.0",
  "description": "Owns plain Genesis-backed Vibe64 chat sessions.",
  "private": true,
  "type": "module",
  "exports": {
    "./shared/conversation": "./src/shared/conversationIdentity.js",
    "./shared/project-watch": "./src/shared/projectWatch.js"
  },
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [
        "vibe64.sessions",
        "assistant.conversations",
        "assistant.conversation.access",
        "vibe64.sessions.repository-updates"
      ],
      "requires": [
        "runtime.actions",
        "runtime.events",
        "runtime.http",
        "runtime.logger",
        "runtime.realtime",
        "vibe64.project",
        "vibe64.source-editor",
        "vibe64.terminals",
        "vibe64.accounts"
      ]
    },
    "runtime": {
      "server": {
        "providers": [
          {
            "entrypoint": "src/server/Vibe64SessionsProvider.js",
            "export": "Vibe64SessionsProvider"
          },
          {
            "entrypoint": "src/server/Vibe64ConversationsProvider.js",
            "export": "Vibe64ConversationsProvider"
          },
          {
            "entrypoint": "src/server/Vibe64SessionsProvider.js",
            "export": "Vibe64RepositoryUpdatesProvider"
          }
        ]
      },
      "client": {
        "providers": []
      }
    },
    "metadata": {
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./shared/conversation",
            "summary": "Exports main and temporary conversation identities and targets."
          },
          {
            "subpath": "./shared/project-watch",
            "summary": "Exports the realtime events a browser uses to watch its projects and sessions."
          }
        ],
        "capabilities": [
          "vibe64.sessions",
          "assistant.conversations",
          "assistant.conversation.access",
          "vibe64.sessions.repository-updates"
        ]
      }
    }
  },
  "dependencies": {
    "@jskit-ai/kernel": "0.2.1",
    "@local/vibe64-core": "0.1.0",
    "@local/vibe64-project": "0.1.0",
    "@local/vibe64-runtime": "0.1.0",
    "@local/vibe64-terminals": "0.1.0",
    "json-rest-schema": "^1.0.17",
    "@local/vibe64-source-editor": "0.1.0",
    "@local/vibe64-accounts": "0.1.0"
  }
}
