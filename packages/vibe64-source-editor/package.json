{
  "name": "@local/vibe64-source-editor",
  "version": "0.1.0",
  "description": "Owns Vibe64 session source-editor file policy, navigation, selected-file sync, search, autosave, and source explanations.",
  "private": true,
  "type": "module",
  "exports": {
    "./server/registerRoutes": "./src/server/registerRoutes.js",
    "./server/service": "./src/server/service.js"
  },
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [
        "vibe64.source-editor"
      ],
      "requires": [
        "runtime.actions",
        "runtime.events",
        "runtime.http",
        "runtime.logger",
        "vibe64.project",
        "vibe64.terminals"
      ]
    },
    "runtime": {
      "server": {
        "providers": [
          {
            "entrypoint": "src/server/Vibe64SourceEditorProvider.js",
            "export": "Vibe64SourceEditorProvider"
          }
        ],
        "capabilities": [
          "vibe64.source-editor"
        ]
      },
      "client": {
        "providers": []
      }
    },
    "metadata": {
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./server/registerRoutes",
            "summary": "Registers session source editor tree, selected-file sync, file matching, source search, read, save, and explanation routes."
          },
          {
            "subpath": "./server/service",
            "summary": "Owns the neutral source-tree policy, selected-file observation, ripgrep-backed file matching/search, file read/autosave operations, and session-scoped source explanation records."
          }
        ]
      }
    }
  },
  "dependencies": {
    "@jskit-ai/kernel": "0.1.183",
    "@local/vibe64-core": "0.1.0",
    "@local/vibe64-execution": "0.1.0",
    "@local/vibe64-project": "0.1.0",
    "@local/vibe64-runtime": "0.1.0",
    "@local/vibe64-terminals": "0.1.0"
  }
}
