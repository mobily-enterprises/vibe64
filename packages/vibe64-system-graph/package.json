{
  "name": "@local/vibe64-system-graph",
  "version": "0.1.0",
  "description": "Reads Genesis Machine and Program Cities for the Vibe64 visual browser.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client/index.js",
    "./server": "./src/server/index.js",
    "./server/registerRoutes": "./src/server/registerRoutes.js",
    "./server/service": "./src/server/service.js"
  },
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [
        "vibe64.system-graph"
      ],
      "requires": [
        "runtime.actions",
        "runtime.http",
        "vibe64.project"
      ]
    },
    "runtime": {
      "server": {
        "providers": [
          {
            "entrypoint": "src/server/Vibe64SystemGraphProvider.js",
            "export": "Vibe64SystemGraphProvider"
          }
        ]
      },
      "client": {
        "providers": []
      }
    },
    "metadata": {
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./server/registerRoutes",
            "summary": "Registers active-session Genesis City status, read, and synchronous refresh routes."
          },
          {
            "subpath": "./server/service",
            "summary": "Reads and validates native Genesis Machine and Program City documents."
          }
        ],
        "capabilities": [
          "vibe64.system-graph"
        ]
      }
    }
  },
  "dependencies": {
    "@jskit-ai/kernel": "0.1.183",
    "@jskit-ai/http-web": "0.1.28",
    "@jskit-ai/shell-web": "0.1.187",
    "@local/vibe64-core": "0.1.0",
    "@local/vibe64-genesis": "0.1.0",
    "@local/vibe64-project": "0.1.0",
    "@mdi/js": "^7.4.47",
    "camera-controls": "^3.1.2",
    "d3-hierarchy": "^3.1.2",
    "three": "^0.185.1",
    "troika-three-text": "^0.52.4",
    "vue": "^3.5.13"
  }
}
