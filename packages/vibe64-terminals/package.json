{
  "name": "@local/vibe64-terminals",
  "version": "0.1.0",
  "description": "Owns Vibe64 Codex and declared output lifecycle.",
  "private": true,
  "type": "module",
  "exports": {
    "./server/actions": "./src/server/actions.js",
    "./server/codexGitCommand": "./src/server/codexGitCommand.js",
    "./server/vibe64OutputTargets": "./src/server/vibe64OutputTargets.js",
    "./server/launchPreviewProxy": "./src/server/launchPreviewProxy.js",
    "./server/projectExecutionEnv": "./src/server/projectExecutionEnv.js",
    "./shared/launchPreviewProtocol": "./src/shared/launchPreviewProtocol.js"
  },
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [
        "vibe64.terminals"
      ],
      "requires": [
        "runtime.actions",
        "runtime.env",
        "runtime.events",
        "runtime.fastify",
        "runtime.http",
        "runtime.logger",
        "runtime.uploads",
        "vibe64.project"
      ]
    },
    "runtime": {
      "server": {
        "providers": [
          {
            "entrypoint": "src/server/Vibe64TerminalsProvider.js",
            "export": "Vibe64TerminalsProvider"
          }
        ]
      },
      "client": {
        "providers": []
      }
    },
    "metadata": {
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./server/registerRoutes",
            "summary": "Registers Vibe64 terminal, attachment, output, and managed preview routes."
          },
          {
            "subpath": "./server/service",
            "summary": "Owns Codex conversation, Vibe64-declared workspace preparation, and output lifecycle."
          },
          {
            "subpath": "./server/projectExecutionEnv",
            "summary": "Resolves Vibe64-owned project Env for terminal processes."
          },
          {
            "subpath": "./server/vibe64OutputTargets",
            "summary": "Translates explicit Vibe64 Outputs declarations into Vibe64-owned output runs."
          }
        ],
        "capabilities": [
          "vibe64.terminals"
        ]
      }
    }
  },
  "dependencies": {
    "@jskit-ai/kernel": "0.1.183",
    "@jskit-ai/uploads-runtime": "0.1.158",
    "@local/vibe64-core": "0.1.0",
    "@local/vibe64-execution": "0.1.0",
    "@local/vibe64-genesis": "0.1.0",
    "@local/vibe64-project": "0.1.0",
    "@local/vibe64-runtime": "0.1.0",
    "@local/studio-terminal-core": "0.1.0",
    "json-rest-schema": "^1.0.16",
    "strip-ansi": "^7.2.0"
  }
}
