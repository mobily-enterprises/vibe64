{
  "name": "@local/vibe64-training",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vibe64 teaching content validation, deterministic bundles and verified pinned snapshot installation and reads.",
  "exports": {
    "./client/lesson-picker": "./src/client/TrainingLessonPicker.vue",
    "./server/actions": "./src/server/actions.js",
    "./server/declared-check": "./src/server/declaredCheck.js",
    "./server/cli": "./src/server/cli.js",
    "./server/content": "./src/server/content.js",
    "./server/catalogue": "./src/server/catalogue.js",
    "./server/installed-content": "./src/server/installedContent.js",
    "./server/content-installer": "./src/server/contentInstaller.js",
    "./server/course-installer": "./src/server/courseInstaller.js",
    "./server/learner-state": "./src/server/learnerState.js",
    "./server/preparation": "./src/server/preparation.js",
    "./server/learning-space": "./src/server/learningSpace.js",
    "./server/practiceHistoryUpgrade": "./src/server/practiceHistoryUpgrade.js",
    "./server/learningSpaceResetUpgrade": "./src/server/learningSpaceResetUpgrade.js",
    "./server/installed-catalogue": "./src/server/installedCatalogue.js",
    "./server/routes": "./src/server/registerRoutes.js",
    "./server/step-checks": "./src/server/stepChecks.js",
    "./server/step-evidence": "./src/server/stepEvidence.js",
    "./server/step-review": "./src/server/stepReview.js",
    "./server/code-authorship": "./src/server/codeAuthorship.js",
    "./server/code-save-owner": "./src/server/codeEditorActions.js",
    "./server/step-actions": "./src/server/stepActions.js",
    "./server/learner-notes-actions": "./src/server/learnerNotesActions.js",
    "./server/learner-events": "./src/server/learnerEvents.js",
    "./server/learning-facts": "./src/server/learningFacts.js",
    "./shared/learner-contract": "./src/shared/learnerContract.js",
    "./shared/learner-events": "./src/shared/learnerEvents.js",
    "./shared/practical-schemas": "./src/shared/practicalSchemas.js",
    "./server/visual-resource-actions": "./src/server/visualResourceActions.js",
    "./server/visual-resource-routes": "./src/server/visualResourceRoutes.js",
    "./shared/presentation-schemas": "./src/shared/presentationSchemas.js",
    "./shared/learning-guidance": "./src/shared/learningGuidance.js",
    "./shared/learning-vocabulary": "./src/shared/learningVocabulary.js",
    "./shared/beats": "./src/shared/beats.js",
    "./client/guide-overlay": "./src/client/TrainingGuideOverlay.vue",
    "./client/guide": "./src/client/trainingGuide.js",
    "./client/course-progress": "./src/client/courseProgress.js",
    "./client/visual-player": "./src/client/TrainingVisualPlayer.vue"
  },
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [
        "vibe64.training"
      ],
      "requires": [
        "runtime.actions",
        "runtime.http",
        "vibe64.project",
        "vibe64.sessions",
        "vibe64.terminals"
      ]
    },
    "runtime": {
      "server": {
        "providers": [
          {
            "entrypoint": "src/server/Vibe64TrainingProvider.js",
            "export": "Vibe64TrainingProvider"
          }
        ]
      },
      "client": {
        "providers": []
      }
    },
    "metadata": {
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./client/lesson-picker",
            "summary": "Displays supplied installed courses with read-only lesson progress, emitting explicit start, resume or owner custom-course intent without state writes."
          }
        ]
      }
    }
  },
  "dependencies": {
    "@jskit-ai/http-web": "0.1.93",
    "@jskit-ai/kernel": "0.1.246",
    "@local/vibe64-core": "0.1.0",
    "@local/vibe64-execution": "0.1.0",
    "@local/vibe64-runtime": "0.1.0",
    "vue": "^3.5.44",
    "@local/vibe64-project": "0.1.0",
    "@local/vibe64-sessions": "0.1.0",
    "@local/vibe64-terminals": "0.1.0"
  }
}
