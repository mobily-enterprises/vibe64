{
  "name": "@local/vibe64-training",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vibe64 teaching content validation, deterministic bundles and verified pinned snapshot installation and reads.",
  "exports": {
    "./client/lesson-picker": "./src/client/TrainingLessonPicker.vue",
    "./client/preview-presentation": "./src/client/TrainingPreviewPresentation.vue",
    "./server/actions": "./src/server/actions.js",
    "./server/presentation-actions": "./src/server/presentationActions.js",
    "./server/teaching-brief": "./src/server/teachingBrief.js",
    "./server/teaching": "./src/server/teaching.js",
    "./server/delivery-proof": "./src/server/deliveryProof.js",
    "./server/teaching-role": "./src/server/teachingRole.js",
    "./server/teaching-actions": "./src/server/teachingActions.js",
    "./server/answer-assessment": "./src/server/answerAssessment.js",
    "./server/assessment-actions": "./src/server/assessmentActions.js",
    "./server/declared-check": "./src/server/declaredCheck.js",
    "./server/cli": "./src/server/cli.js",
    "./server/content": "./src/server/content.js",
    "./server/catalogue": "./src/server/catalogue.js",
    "./server/installed-content": "./src/server/installedContent.js",
    "./server/content-installer": "./src/server/contentInstaller.js",
    "./server/learner-state": "./src/server/learnerState.js",
    "./server/learning-sessions": "./src/server/learningSessions.js",
    "./server/preparation": "./src/server/preparation.js",
    "./server/practiceHistoryUpgrade": "./src/server/practiceHistoryUpgrade.js",
    "./server/installed-catalogue": "./src/server/installedCatalogue.js",
    "./server/routes": "./src/server/registerRoutes.js",
    "./server/conversation-assessment": "./src/server/conversationAssessment.js",
    "./client/presentation-cue": "./src/client/useTrainingPresentationCue.js",
    "./client/navigation": "./src/client/createTrainingNavigation.js",
    "./server/practical-observations": "./src/server/practicalObservations.js",
    "./server/practical-actions": "./src/server/practicalActions.js",
    "./server/main-practical-actions": "./src/server/mainPracticalActions.js",
    "./shared/practical-schemas": "./src/shared/practicalSchemas.js",
    "./server/main-teaching": "./src/server/mainTeaching.js",
    "./server/main-presentation-actions": "./src/server/mainPresentationActions.js",
    "./server/main-presentation-routes": "./src/server/mainPresentationRoutes.js",
    "./client/main-presentation": "./src/client/useTrainingMainPresentation.js",
    "./server/visual-resource-actions": "./src/server/visualResourceActions.js",
    "./server/visual-resource-routes": "./src/server/visualResourceRoutes.js",
    "./client/preview-registration": "./src/client/useTrainingPreviewRegistration.js",
    "./server/presentation-coordination": "./src/server/presentationCoordination.js",
    "./client/presentation-operation": "./src/client/presentationOperation.js",
    "./shared/presentation-schemas": "./src/shared/presentationSchemas.js"
  },
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [
        "vibe64.training"
      ],
      "requires": [
        "runtime.actions",
        "runtime.http",
        "vibe64.project",
        "vibe64.sessions",
        "vibe64.terminals"
      ]
    },
    "runtime": {
      "server": {
        "providers": [
          {
            "entrypoint": "src/server/Vibe64TrainingProvider.js",
            "export": "Vibe64TrainingProvider"
          }
        ]
      },
      "client": {
        "providers": []
      }
    },
    "metadata": {
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./client/preview-presentation",
            "summary": "Retains the App preview beside the exact lesson's controlled SVG presentation."
          },
          {
            "subpath": "./client/lesson-picker",
            "summary": "Displays supplied installed lesson choices and saved progress, emitting explicit start or resume intent without state writes."
          },
          {
            "subpath": "./client/presentation-cue",
            "summary": "Coordinates original exact-output cue speech and terminal receipts with the existing Preview and voice owners."
          }
        ]
      }
    }
  },
  "dependencies": {
    "@jskit-ai/http-web": "0.1.75",
    "@jskit-ai/kernel": "0.1.230",
    "@local/vibe64-core": "0.1.0",
    "@local/vibe64-execution": "0.1.0",
    "@local/vibe64-runtime": "0.1.0",
    "vue": "^3.5.43",
    "@local/vibe64-project": "0.1.0",
    "@local/vibe64-sessions": "0.1.0",
    "@local/vibe64-terminals": "0.1.0"
  }
}
